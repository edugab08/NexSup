# ─── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexsupport?schema=public"

# ─── Autenticação ─────────────────────────────────────────────────────────────
JWT_SECRET="troque-esta-chave-em-producao"

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Valores de PRODUÇÃO: THROTTLE_LIMIT=100 e LOGIN_THROTTLE_LIMIT=5 (por minuto, por IP).
# Para rodar o Cypress várias vezes seguidas sem tomar 429, mantenha valores altos:
THROTTLE_LIMIT=1000
LOGIN_THROTTLE_LIMIT=100

# ─── Opcional: credenciais do admin criado pelo seed ──────────────────────────
# ADMIN_EMAIL=admin@nexsupport.com
# ADMIN_PASSWORD=admin123
